# ---------------------------------------------
# إعدادات تربوي بوت - دبلومة التأهيل التربوي
# ---------------------------------------------

# توكن البوت المستخرج من @BotFather
BOT_TOKEN=1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ

# معرّفات المشرفين (أرقام ID مفصولة بفواصل)
ADMIN_IDS=123456789,987654321

# معرّف أو يوزرنيم قناة/مجموعة الأرشيف (لحفظ وتخزين الملفات نهائياً)
# مثال: -1001234567890 أو @my_archive_channel
ARCHIVE_CHANNEL_ID=-1001234567890

# معرّف مجموعة دبلومة التأهيل التربوي الرئيسية (للتحقق من العضوية وإرسال الإشعارات)
# مثال: -1009876543210
MAIN_GROUP_ID=-1009876543210

# مسار قاعدة بيانات SQLite
DB_PATH=data/tarbiwi.db

# الحد الأقصى لحجم الملفات بالميجابايت
MAX_FILE_SIZE_MB=50

# مدة منع التكرار والفلود بين عمليات الرفع بالثواني
UPLOAD_RATE_LIMIT_SECONDS=10
